OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=false

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false
LANGGRAPH_LOCAL_AUTH=true

# Local workbench defaults
SEARCH_API=tavily
RESEARCH_MODEL=openai:qwen3.7-flash
SUMMARIZATION_MODEL=openai:qwen3.7-flash
COMPRESSION_MODEL=openai:qwen3.7-flash
FINAL_REPORT_MODEL=openai:qwen3.7-flash
DEEPSEEK_API_KEY=

# Business persistence (PostgreSQL)
DATABASE_URI=
AGENTLAB_DATABASE_URI=
AGENTLAB_PROVIDER_MODE=real
TASK_ATTEMPT_LEASE_SECONDS=900
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
